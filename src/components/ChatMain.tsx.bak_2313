import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import codexhubAvatar from '../assets/codexhub-avatar.svg';
import './ChatMain.css';
import { calculateCost, fmtCost } from '../pricing';

/* ── 每工具斜杠命令 ── */
