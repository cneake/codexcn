/* ── Props ── */
interface Props {
  toolId: string;
  activeView: string;
  onViewChange: (view: string) => void;
  collapsed: boolean;
  onToggleCollapse?: () => void;
  onOpenChangelog?: () => void;
  onOpenProviders?: () => void;
  onOpenTheme?: () => void;
  onOpenDonate?: () => void;
  onCheckVersion?: () => void;
  onOpenAbout?: () => void;
  onOpenQuickConfig?: () => void;
  onOpenQuickSwitch?: () => void;
  onOpenMcp?: () => void;
}

export default function ChatSidebar({ toolId, activeView, onViewChange, collapsed, onToggleCollapse, onOpenChangelog, onOpenProviders, onOpenTheme, onOpenDonate, onCheckVersion, onOpenAbout, onOpenQuickConfig, onOpenQuickSwitch, onOpenMcp }: Props) {
  const menus = TOOL_SIDEBAR_MENUS[toolId] || DEFAULT_MENUS;
  const toolInfo = TOOL_INFO[toolId] || { name: toolId, icon: '🤖' };

  const [groupCollapsed, setGroupCollapsed] = useState<Record<string, boolean>>(() => {
    try {
      const saved = localStorage.getItem('codexhub-sidebar-groups');
      if (saved) return JSON.parse(saved);
    } catch {}
    const init: Record<string, boolean> = {};
    menus.forEach(g => { init[g.id] = false; });
    return init;
  });

  /* 检测浅色模式 — 用 state + MutationObserver 实时响应 */
  const [isLightTheme, setIsLightTheme] = useState(() => document.documentElement.getAttribute('data-theme') === 'light');
  useEffect(() => {
    const observer = new MutationObserver(() => {
      setIsLightTheme(document.documentElement.getAttribute('data-theme') === 'light');
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    localStorage.setItem('codexhub-sidebar-groups', JSON.stringify(groupCollapsed));
  }, [groupCollapsed]);

  const toggleGroup = (id: string) => {
    setGroupCollapsed(prev => ({ ...prev, [id]: !prev[id] }));
  };

  const isGroupCollapsed = (id: string) => !!groupCollapsed[id];
  const getIcon = (name: string) => Icons[name] || Icons.settings;

  return (
    <aside className={`chat-sidebar${collapsed ? ' collapsed' : ''}`}>
      <div className="sidebar-logo" onClick={() => onViewChange('new-chat')}>
        <img src={toolInfo.icon} alt={toolInfo.name} className="logo-icon-img" style={{width:24,height:24,borderRadius:4}} />
        {!collapsed && <span className="logo-text">{toolInfo.name}</span>}
      </div>

      <nav className="sidebar-nav">
        {menus.map(group => (
          <div key={group.id} className="nav-group">
            <div className="nav-group-label" onClick={() => toggleGroup(group.id)}>
              {getIcon(group.icon)}
              {!collapsed && <span>{group.label}</span>}
              {!collapsed && <svg className={`nav-group-arrow${isGroupCollapsed(group.id) ? ' collapsed' : ''}`} width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 12 15 18 9" /></svg>}
            </div>
            {collapsed ? (
              <div className="nav-group-items">
                {group.children.map(sub => {
                  const handleSubClick = () => {
                    if (sub.id === 'providers') return onOpenProviders?.();
                    if (sub.id === 'theme') return onOpenTheme?.();
                    if (sub.id === 'donate') return onOpenDonate?.();
                    if (sub.id === 'check-update') return onCheckVersion?.();
                    if (sub.id === 'about') return onOpenAbout?.();
                    if (sub.id === 'quick-config') return onOpenQuickConfig?.();
                    if (sub.id === 'quick-switch') return onOpenQuickSwitch?.();
                    if (sub.id === 'mcp') return onOpenMcp?.();
                    onViewChange(sub.id);
                  };
                  return (
                    <div key={sub.id} className={`nav-item${activeView === sub.id ? ' active' : ''}`} onClick={handleSubClick} title={sub.label}>
                      {getIcon(sub.icon)}
                    </div>
                  );
                })}
              </div>
            ) : (
              <div className="nav-group-items">
                {group.children.map(sub => {
                  const handleSubClick = () => {
                    if (sub.id === 'providers') return onOpenProviders?.();
                    if (sub.id === 'theme') return onOpenTheme?.();
                    if (sub.id === 'donate') return onOpenDonate?.();
                    if (sub.id === 'check-update') return onCheckVersion?.();
                    if (sub.id === 'about') return onOpenAbout?.();
                    if (sub.id === 'quick-config') return onOpenQuickConfig?.();
                    if (sub.id === 'quick-switch') return onOpenQuickSwitch?.();
                    if (sub.id === 'mcp') return onOpenMcp?.();
                    onViewChange(sub.id);
                  };
                  return (
                    <div key={sub.id} className={`nav-item${activeView === sub.id ? ' active' : ''}`} onClick={handleSubClick} title={sub.label}>
                      {getIcon(sub.icon)}
                      <span>{sub.label}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        ))}
      </nav>

      {/* 收起/展开按钮 */}
      <div className="sidebar-collapse-btn" onClick={onToggleCollapse} title={collapsed ? '展开' : '收起'}>
        {collapsed ? '>>' : '<<'}
      </div>
    </aside>
  );
}
