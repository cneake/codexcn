#[tauri::command]
fn get_usage_stats(db: tauri::State<'_, Database>) -> Vec<ToolUsage> {
    // 从 token_usage_log 表聚合各工具用量
    let tool_ids = ["claude-code","claude-desktop","codex","gemini-cli","opencode","openclaw","hermes-agent","qoder-cli","deepseek-cli"];
    let mut result = Vec::new();
    for tid in &tool_ids {
        let (input, output, total) = db.get_token_usage_by_tool(tid).unwrap_or((0,0,0));
        result.push(ToolUsage {
            tool_id: tid.to_string(),
            tool_name: tid.to_string(),
            supported: total > 0,
            total_sessions: 0,
            total_input_tokens: input as u64,
            total_output_tokens: output as u64,
            total_cache_read_tokens: 0,
            total_cache_creation_tokens: 0,
            daily: vec![],
        });
    }
    result
}

#[tauri::command]
fn get_total_usage(db: tauri::State<'_, Database>) -> usage::TotalUsage {
    let tool_ids = ["claude-code","claude-desktop","codex","gemini-cli","opencode","openclaw","hermes-agent","qoder-cli","deepseek-cli"];
    let mut total_input = 0u64;
    let mut total_output = 0u64;
    let mut count = 0u64;
    
    for tid in &tool_ids {
        let (input, output, total) = db.get_token_usage_by_tool(tid).unwrap_or((0,0,0));
        if total > 0 {
            total_input += input as u64;
            total_output += output as u64;
            count += 1;
        }
    }
    
    usage::TotalUsage {
        total_input_tokens: total_input,
        total_output_tokens: total_output,
        tool_count: count,
    }
}

#[tauri::command]
fn get_daily_usage(db: tauri::State<'_, Database>, tool_id: String, days: Option<u64>) -> Result<Vec<Vec<serde_json::Value>>, String> {
    let keep_days = days.unwrap_or(7);
    let rows = db.get_daily_token_usage(&tool_id, keep_days)?;
    // Return as array of [date, input_tokens, output_tokens]
    Ok(rows.into_iter().map(|(date, inp, out)| {
        vec![
            serde_json::Value::String(date),
            serde_json::Value::Number(serde_json::Number::from(inp)),
            serde_json::Value::Number(serde_json::Number::from(out)),
        ]
    }).collect())
}

#[tauri::command]
fn toggle_skill_overlay(app: tauri::AppHandle) -> Result<(), String> {
    
    if let Some(window) = app.get_webview_window("skill-overlay") {
        let visible = window.is_visible().map_err(|e| e.to_string())?;
        if visible {
            window.hide().map_err(|e| e.to_string())?;
        } else {
            window.show().map_err(|e| e.to_string())?;
            window.set_focus().map_err(|e| e.to_string())?;
        }
        return Ok(());
    }
    
    // 创建新窗口
    let _window = tauri::webview::WebviewWindowBuilder::new(
        &app,
        "skill-overlay",
        tauri::WebviewUrl::App("index.html".into()),
    )
    .initialization_script("window.__IS_SKILL_OVERLAY__ = true;")
    .title("技能调用")
    .inner_size(300.0, 500.0)
    .min_inner_size(240.0, 300.0)
    .decorations(false)
    .always_on_top(true)
    .resizable(true)
    .skip_taskbar(true)
    .background_color(tauri::webview::Color(18, 18, 30, 255))
    .build()
    .map_err(|e| e.to_string())?;
    
    Ok(())
}

#[tauri::command]
fn log_skill_invoke(app: tauri::AppHandle, db: tauri::State<'_, Database>, tool_id: String, skill_slug: String, skill_name: String) -> Result<i64, String> {
    let id = db.log_skill_invoke(&tool_id, &skill_slug, &skill_name)
        .map_err(|e| format!("DB insert failed: {}", e))?;
    let created_at = chrono::Local::now().format("%Y-%m-%dT%H:%M:%S").to_string();
    let payload = serde_json::json!({
        "id": id,
        "tool_id": tool_id.clone(),
        "skill_slug": skill_slug,
        "skill_name": skill_name,
        "created_at": created_at,
    });
    let _ = app.emit("skill-invoked", payload);
    // 弹出技能调用记录浮窗（独立子窗口，可拖出软件边界）
    let app_clone = app.clone();
    tauri::async_runtime::spawn(async move {
        show_or_create_overlay(&app_clone).await;
    });
    Ok(id)
}

fn overlay_debug(msg: &str) {
    use std::io::Write;
    let path = std::env::temp_dir().join("overlay_debug.log");
    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
        let _ = writeln!(f, "{}", msg);
    }
}

async fn show_or_create_overlay(app: &tauri::AppHandle) {
    let overlay_w = 200.0; // 调整宽度为200px

    // 获取主窗口位置和尺寸
    let (main_x, main_y, main_w, main_h) = if let Some(main_win) = app.get_webview_window("main") {
        if let (Ok(op), Ok(os), Ok(ip), Ok(is)) = (main_win.outer_position(), main_win.outer_size(), main_win.inner_position(), main_win.inner_size()) {
            overlay_debug(&format!("OUTER pos=({},{}) size={}x{}  INNER pos=({},{}) size={}x{}", op.x, op.y, os.width, os.height, ip.x, ip.y, is.width, is.height));
            (op.x as f64, op.y as f64, os.width as f64, os.height as f64)
        } else { 
            overlay_debug("failed to get main window pos/size");
            (100.0, 100.0, 1100.0, 720.0) 
        }
    } else { 
        overlay_debug("main window not found");
        (100.0, 100.0, 1100.0, 720.0) 
    };

    // 计算浮窗位置：主窗口右侧，上下各缩进 5px，左移 1px 覆盖主窗口右边框消除 frameless 透明缝隙
    let overlay_x = main_x + main_w - 16.0;
    let overlay_y = main_y;
    let overlay_h = main_h - 8.0;

    eprintln!("[overlay] target pos=({}, {}) size=({}x{})", overlay_x, overlay_y, overlay_w, overlay_h);

    overlay_debug(&format!("TARGET x={} y={} w={} h={}", overlay_x, overlay_y, overlay_w, overlay_h));

    // 已有浮窗 → 更新位置和大小后显示
    if let Some(win) = app.get_webview_window("skill-overlay") {
        let _ = win.set_position(tauri::PhysicalPosition::new(overlay_x as i32, overlay_y as i32));
        let _ = win.set_size(tauri::PhysicalSize::new((overlay_w - 16.0) as u32, overlay_h as u32));
        let _ = win.show();
        let _ = win.set_focus();
        return;
    }

    // 创建新窗口
    let url = tauri::WebviewUrl::App("index.html?window=skill-overlay".into());
    let _overlay_win = match tauri::webview::WebviewWindowBuilder::new(app, "skill-overlay", url)
        .title("技能调用")
        .inner_size(184.0, 700.0)
        .min_inner_size(180.0, 200.0)
        .decorations(false)
        .resizable(false)
        .skip_taskbar(true)
        .transparent(false)
        .background_color(tauri::webview::Color(18, 18, 30, 255))
        .build()
    {
        Ok(w) => {
            // 用 physical 坐标设置位置和大小，与 on_window_event / 已有分支完全一致（避免 logical/physical 混用导致 DPI 缩放错位）
            let _ = w.set_position(tauri::PhysicalPosition::new(overlay_x as i32, overlay_y as i32));
            let _ = w.set_size(tauri::PhysicalSize::new((overlay_w - 16.0) as u32, overlay_h as u32));
            if let (Ok(ap), Ok(asz)) = (w.outer_position(), w.outer_size()) {
                overlay_debug(&format!("ACTUAL overlay pos=({},{}) size={}x{}", ap.x, ap.y, asz.width, asz.height));
            }
            w
        },
        Err(e) => { 
            eprintln!("[skill-overlay] build error: {}", e); 
            return; 
        }
    };
}

#[tauri::command]
fn get_recent_skill_invokes(db: tauri::State<'_, Database>, limit: Option<u32>) -> Result<Vec<serde_json::Value>, String> {
    let rows = db.get_recent_skill_invokes(limit.unwrap_or(50))?;
    Ok(rows.into_iter().map(|(id, tool_id, slug, name, ts)| {
        serde_json::json!({
            "id": id,
            "tool_id": tool_id,
            "skill_slug": slug,
            "skill_name": name,
            "created_at": ts,
        })
    }).collect())
}

#[tauri::command]
fn get_main_window_rect(app: tauri::AppHandle) -> Option<serde_json::Value> {
    app.get_webview_window("main").and_then(|w| {
        let pos = w.outer_position().ok()?;
        let size = w.outer_size().ok()?;
        let x = pos.x as f64;
        let y = pos.y as f64;
        let width = size.width as f64;
        let height = size.height as f64;
        eprintln!("[get_main_window_rect] x={} y={} w={} h={}", x, y, width, height);
        Some(serde_json::json!({
            "x": x,
            "y": y,
            "width": width,
            "height": height
        }))
    })
}

